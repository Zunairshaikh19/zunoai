rules_version = '2';

// SECURITY MODEL
// --------------
// Money-like state (coins, tier/premium, ad counters, streak, referral data)
// is NEVER writable by the mobile client. It is changed only by the Supabase
// Edge Functions (economy, generate-image, confirm-purchase, admob-ssv), which
// use a service account and therefore bypass these rules.
// The client may only touch harmless profile fields (name, photo, gender,
// push token, last-activity).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Fields that actually change in an update.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Admin allowlist — add a document with the admin's Firebase Auth uid as the
    // document id (fields don't matter) to grant that account admin access.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // manage via Firebase console / Admin SDK only
    }

    // referral code -> owner uid. Created and read only by the economy function.
    match /referralCodes/{code} {
      allow read, write: if false;
    }

    match /prompts/{promptId} {
      // Public style catalog — guests browse the dashboard before signing in.
      // The secret prompt text lives in promptSecrets (admin/server only).
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promptSecrets/{promptId} {
      allow read, write: if isAdmin();
    }

    match /settings/config {
      // Holds the AI provider API key — never exposed to the mobile client.
      allow read, write: if isAdmin();
    }

    match /settings/economy {
      // Coin amounts / limits only — no secrets. Readable by everyone (guests
      // included) so the UI shows live numbers; only admins can change them.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Profiles are created by the `economy` function (action: init-profile)
      // so a client can never invent its own coins/tier/referral code.
      allow create: if isAdmin();

      // Owner may change ONLY these harmless fields, with basic validation.
      // Anything else (coins, tier, premiumExpiresAt, isBlocked, referral*,
      // dailyAdsWatched, loginStreak, lastDailyReset, ...) is rejected.
      allow update: if isAdmin() || (
        isOwner(uid) &&
        changedKeys().hasOnly(['displayName', 'photoUrl', 'gender', 'fcmToken', 'lastActivity']) &&
        (!('displayName' in changedKeys()) ||
          (request.resource.data.displayName is string &&
           request.resource.data.displayName.size() <= 60)) &&
        (!('photoUrl' in changedKeys()) ||
          (request.resource.data.photoUrl is string &&
           request.resource.data.photoUrl.size() <= 500 &&
           request.resource.data.photoUrl.matches('https://.*'))) &&
        (!('gender' in changedKeys()) ||
          request.resource.data.gender in ['male', 'female', 'unisex']) &&
        (!('fcmToken' in changedKeys()) ||
          request.resource.data.fcmToken == null ||
          (request.resource.data.fcmToken is string &&
           request.resource.data.fcmToken.size() <= 400)) &&
        (!('lastActivity' in changedKeys()) ||
          request.resource.data.lastActivity == request.time)
      );

      allow delete: if isAdmin();

      match /history/{historyId} {
        // History is written by the generate-image function (server-side),
        // so a client can neither forge nor tamper with it.
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid) || isAdmin();
        // Only the server (referral bonus etc.) or an admin creates notifications.
        allow create: if isAdmin();
        // The owner can only mark one as read.
        allow update: if isAdmin() ||
          (isOwner(uid) && changedKeys().hasOnly(['isRead']));
        allow delete: if isAdmin();
      }
    }

    match /coinAdjustments/{adjustmentId} {
      // Audit log of manual admin coin grants — admin-only, append-only.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /support_tickets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.userId == uid &&
        request.resource.data.status == 'open'
      );
      allow update: if isAdmin() || (
        isOwner(uid) &&
        changedKeys().hasOnly(['lastMessage', 'lastTimestamp', 'userId', 'status']) &&
        request.resource.data.userId == uid &&
        request.resource.data.status == 'open'
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(uid) || isAdmin();
        // A user can only post as themselves, never as an admin.
        allow create: if isAdmin() || (
          isOwner(uid) &&
          request.resource.data.senderId == uid &&
          request.resource.data.isAdmin == false &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 2000
        );
        allow update, delete: if isAdmin();
      }
    }

    // adRewards, generationJobs, purchaseTokens, subscriptions, ... are
    // server-only and fall through to the default deny below.

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
