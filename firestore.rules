rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // True only if the caller's own profile records that `inviterUid`'s referral
    // code actually referred them in — proving a real referral relationship
    // rather than an arbitrary write to someone else's document.
    function isLegitReferralCredit(inviterUid) {
      return isSignedIn() && request.auth.uid != inviterUid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.referredBy ==
        get(/databases/$(database)/documents/users/$(inviterUid)).data.referralCode;
    }

    // Admin allowlist — add a document with the admin's Firebase Auth uid as the
    // document id (fields don't matter) to grant that account admin access.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // manage via Firebase console / Admin SDK only
    }

    // Maps a referral code -> owning uid, so a user can look up "whose code is
    // this?" without needing read access to arbitrary user profiles.
    match /referralCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /prompts/{promptId} {
      // Public style catalog — guests browse the dashboard before signing in.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/config {
      // Holds the AI provider API key — never exposed to the mobile client.
      // The generation backend reads this with a service-account credential,
      // which bypasses these rules entirely.
      allow read, write: if isAdmin();
    }

    match /settings/economy {
      // Coin amounts / limits only — no secrets — so the app can read live
      // values without a store release, while only admins can change them.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);

      // A user may let their own expired subscription lapse (paid -> free),
      // but can never grant themselves premium — only an admin, or the
      // purchase-verifying backend (via a service account, bypassing rules),
      // can do that.
      function isSelfExpiry() {
        return isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tier', 'premiumExpiresAt']) &&
          resource.data.tier == 'paid' &&
          request.resource.data.tier == 'free';
      }

      // Lets an account whose referralCode is missing (a legacy profile from
      // before referral codes existed, or any write that landed without one)
      // fill it in once — never lets an existing code be changed/reassigned.
      function isReferralCodeBackfill() {
        return isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralCode']) &&
          // A legacy doc from before this field existed doesn't have the key
          // at all — accessing a missing map key directly (rather than
          // guarding with `in` first) errors out the whole rule and denies
          // the write, so both "missing" and "empty string" must be handled.
          (!('referralCode' in resource.data) || resource.data.referralCode == '') &&
          request.resource.data.referralCode is string &&
          request.resource.data.referralCode != '';
      }

      // Lets an account whose real profile was never written (a phantom doc
      // created only by updateLastActivity()/updateFcmToken()'s upsert, with
      // no real email) get its full profile backfilled in one write — but
      // only into safe starting values, never into premium/blocked/etc.
      function isProfileBackfill() {
        return isOwner(uid) &&
          (!('email' in resource.data) || resource.data.email == '') &&
          request.resource.data.email is string &&
          request.resource.data.email != '' &&
          request.resource.data.tier == 'free' &&
          request.resource.data.isBlocked == false;
      }

      // Users may update their own profile, but not grant themselves premium,
      // unblock themselves, or forge their own referral identity.
      allow update: if isAdmin() || isSelfExpiry() || isReferralCodeBackfill() || isProfileBackfill() || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['tier', 'isBlocked', 'referralCode', 'uid', 'email'])
      ) || (
        isLegitReferralCredit(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'referralCount'])
      );

      allow delete: if isAdmin();

      match /history/{historyId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if isAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid) || isAdmin();
        // A referred user is allowed to drop a "you earned a referral bonus"
        // notification into their inviter's inbox at signup/redeem time.
        allow create: if isOwner(uid) || isAdmin() || isLegitReferralCredit(uid);
        allow update: if isOwner(uid) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /coinAdjustments/{adjustmentId} {
      // Audit log of manual admin coin grants — admin-only, append-only.
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /support_tickets/{uid} {
      allow read, create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if isOwner(uid) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
